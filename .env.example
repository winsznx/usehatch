# =============================================================================
# Hatch — environment variables
# =============================================================================
# Copy this to `.env` and fill in values. Required vars are marked [REQUIRED].
# Vars marked [DEV] are only needed for local development / integration tests.
# Vars marked [PROD] are needed when running against managed infra.
# Never commit `.env` (it's gitignored). chmod 600 it locally.
# =============================================================================


# -----------------------------------------------------------------------------
# Chain — Story Aeneid (chain ID 1315)
# -----------------------------------------------------------------------------
# [REQUIRED] EVM JSON-RPC endpoint. Aeneid public RPC; swap for a managed
# endpoint (Alchemy / QuickNode / Tenderly) in production.
RPC_URL=https://aeneid.storyrpc.io

# [REQUIRED] Story-API REST endpoint — serves DKG / CDR state the
# Story EVM RPC doesn't expose. Used by @piplabs/cdr-sdk Observer.
STORY_API_URL=http://172.192.41.96:1317


# -----------------------------------------------------------------------------
# Wallets — Aeneid testnet private keys
# -----------------------------------------------------------------------------
# Generated by scripts/gen-wallets.mjs; fund PUBLISHER+SUBSCRIBER from a faucet
# or out-of-band transfer. ANON is funded on-chain from PUBLISHER.
# DO NOT commit. DO NOT reuse on mainnet.

# [REQUIRED] Publisher / deployer / test treasury. Owns deployed contracts;
# acts as Oracle operator in test runs.
PUBLISHER_PK=0x...
PUBLISHER_ADDR=0x...

# [REQUIRED for tests] Subscriber / consumer wallet.
SUBSCRIBER_PK=0x...
SUBSCRIBER_ADDR=0x...

# [REQUIRED for tests] Anonymous wallet / SUBSCRIBER2 in round-trip.
ANON_PK=0x...
ANON_ADDR=0x...


# -----------------------------------------------------------------------------
# Backend — API + database + queue
# -----------------------------------------------------------------------------
# [DEV] HTTP port the Hono API binds to. Production usually behind Railway's
# port mapping; let Railway set this.
API_PORT=4011

# [DEV] Test scripts hit this URL. In production the frontend uses the
# canonical https://api.usehatch.xyz (or whatever you deploy to).
API_URL=http://127.0.0.1:4011

# [REQUIRED] Postgres connection string. Local Postgres for dev;
# Supabase Postgres (transaction pooler URL) for prod.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hatch

# [REQUIRED] BullMQ-backed reveal worker + distribute queue. Docker Redis
# (`redis:7-alpine -p 55379:6379`) for dev; Railway Redis for prod.
REDIS_URL=redis://127.0.0.1:55379

# [REQUIRED] Block number the indexer starts backfilling from on first boot.
# Pick a block just before your contract deploys. The indexer maintains
# its own cursor after that.
INDEXER_START_BLOCK=18800000


# -----------------------------------------------------------------------------
# Reveal worker + ephemeral pool
# -----------------------------------------------------------------------------
# [REQUIRED] Treasury wallet that funds ephemeral pool slots. Same key as
# PUBLISHER_PK in dev; should be a dedicated relay treasury in production
# (don't expose your publisher creator key to the worker process).
SERVER_TREASURY_PK=0x...

# [DEV] Size of the reveal worker's hot-wallet pool. 4 is plenty at 5–10
# concurrent reveals; raise carefully — every slot drains treasury on top-up.
REVEAL_POOL_SIZE=4

# [DEV] Size of the API's own pool used for anonymous post-reveal reads.
SERVER_POOL_SIZE=4

# [TEST-ONLY] Comma-separated `addr=privatekey` mappings used by the API
# to orchestrate kind=1 anonymous lent-pass reads server-side. DO NOT SET
# IN PRODUCTION — production requires client-orchestrated lend (or
# HatchSubscriptionPass v2.2 with EIP-712 lendBySig).
# Example: TEST_WALLET_PKS=0xabc...=0xdef...,0x123...=0x456...
TEST_WALLET_PKS=


# -----------------------------------------------------------------------------
# Storage — encrypted manifest media (CDR StorageProvider)
# -----------------------------------------------------------------------------
# [DEV] LocalDiskProvider directory. Used when Supabase vars are unset.
LOCAL_STORAGE_DIR=/tmp/hatch-roundtrip-storage

# [PROD] Supabase Storage — encrypted bucket for manifest media.
# Create a bucket, mint a service-role key. All three must be set
# together; absence falls back to LocalDiskProvider.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=hatch-media


# -----------------------------------------------------------------------------
# Deployed contracts (Aeneid)
# -----------------------------------------------------------------------------
# Set these to override the SDK's compiled-in addresses. Most callers won't
# touch them — they're read by helpers that rewire test deployments.

# [DEV] Override the Registry address — used by the round-trip test to
# point at a freshly-deployed Registry instead of the canonical one.
REGISTRY_ADDR=


# -----------------------------------------------------------------------------
# Build 6 — Bluesky bot (free posting; replaces X for v1)
# -----------------------------------------------------------------------------
# X's free tier is READ_ONLY (cannot post tweets), so v1 distribution uses
# Bluesky via AT Protocol. Create a Bluesky account, then Settings → App
# Passwords → generate one. Bluesky has no public posting quota worth
# tracking at hackathon scale.
BSKY_HANDLE=                  # e.g. "hatch.bsky.social"
BSKY_APP_PASSWORD=            # 19-char app password from Bluesky settings

# X / Twitter (DEFERRED — free tier is READ_ONLY, cannot post tweets).
# Keys are stored so the bot can be flipped to X once the tier is upgraded
# to Basic ($100/mo) or higher. X_API_TIER=read_only is the soft-block;
# set X_API_TIER=write_enabled to actually attempt posts.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_API_TIER=read_only

# Canonical public URL for hatch links in posts. Used by the bot as
# `${HATCH_PUBLIC_URL}/h/{uuid}`. NO trailing slash. When you deploy the
# frontend to Railway, copy the auto-generated URL here (looks like
# https://<service>-production-<hash>.up.railway.app) or your Namecheap
# custom domain once DNS is wired.
HATCH_PUBLIC_URL=https://hatch.usehatch.xyz


# -----------------------------------------------------------------------------
# Build 6 — Notifications (Resend + Web Push)
# -----------------------------------------------------------------------------
# Resend (free tier: 3k emails/month, 100/day, single verified domain).
# RESEND_FROM must be on a domain you've verified in the Resend dashboard.
RESEND_API_KEY=
RESEND_FROM=hatch <noreply@usehatch.xyz>

# Web Push — VAPID key pair. Generate once with `npx web-push generate-vapid-keys`;
# the public key is shipped to the browser, the private key stays server-side.
# VAPID_SUBJECT is an mailto: or https: URL identifying the sender.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@usehatch.xyz


# -----------------------------------------------------------------------------
# Build 7 — Oracle data service + aggregator
# -----------------------------------------------------------------------------
# CoinGecko Demo API (free tier; sign up at coingecko.com/en/developers/dashboard).
# Used by the oracle worker for price-outcome attestations.
COINGECKO_DEMO_KEY=

# Optional: The Odds API (free tier 500 req/mo) for sports outcomes.
# If unset, sports-kind outcomes are skipped (not an error — alpha/scoops
# don't need oracle resolution).
ODDS_API_KEY=

# Oracle operator wallet — generated separately from publisher/treasury.
# Must be allowlisted on HatchOracle via owner.addOperator(OPERATOR_ADDRESS)
# (one-time setup; the runner auto-registers on boot if not present).
# Needs ~0.05 IP for gas (submitAttestation + finalize). Generate fresh with:
#   node --input-type=module -e 'import {generatePrivateKey, privateKeyToAccount} \
#     from "viem/accounts"; const pk=generatePrivateKey(); \
#     console.log(pk, privateKeyToAccount(pk).address)'
OPERATOR_PRIVATE_KEY=
OPERATOR_ADDRESS=


# -----------------------------------------------------------------------------
# Notes
# -----------------------------------------------------------------------------
# - Aeneid is a TESTNET. Tokens have no monetary value. Do not promote keys.
# - The fallback RPC `rpc.odyssey.storyrpc.io` is Cloudflare-blocked from many
#   hosts; rely on the primary `aeneid.storyrpc.io`.
# - Story-API REST `172.192.41.96:1317` is an IP literal because the SDK's
#   Observer reads `/dkg/*` paths there. Standard cosmos paths 404.
# - Production should rotate PUBLISHER_PK + SERVER_TREASURY_PK into separate
#   wallets behind a secrets manager (Railway shared variables, Doppler, 1P).
