# Hatch frontend env. Copy to .env.local to override. Vite exposes vars
# prefixed `VITE_` to the browser bundle.

# Backend REST + WS base URL. Local dev: http://127.0.0.1:4011.
# Production: the Railway/Vercel URL of @usehatch/backend.
VITE_BACKEND_URL=http://127.0.0.1:4011

# Story Aeneid RPC. The official endpoint works for testnet.
VITE_RPC_URL=https://aeneid.storyrpc.io

# Optional: comma-separated secondary RPC endpoints. Wagmi + viem rank these
# by health and fall back automatically on transient failures. Leave empty
# for single-RPC operation. Example:
#   VITE_RPC_URL_FALLBACKS=https://rpc-1.alt.example,https://rpc-2.alt.example
VITE_RPC_URL_FALLBACKS=

VITE_CHAIN_ID=1315

# WalletConnect / Reown project id. Required for WalletConnect QR + mobile
# wallets in the RainbowKit modal. Get one at https://cloud.reown.com.
VITE_WALLETCONNECT_PROJECT_ID=

# ─────────────── Privy (email login + Pimlico-sponsored smart wallets)
# When VITE_PRIVY_APP_ID is set, the app activates the Privy provider stack.
# Privy's embedded wallet appears as a wagmi connector inside RainbowKit's
# modal — users can sign in with email and skip MetaMask entirely.
#
# Setup:
#   1. Create an app at https://dashboard.privy.io → copy App ID below.
#   2. Privy dashboard → Networks → add Story Aeneid (chain 1315, RPC
#      https://aeneid.storyrpc.io).
#   3. Privy dashboard → Smart Wallets → enable on Aeneid (1315). Paste
#      your Pimlico bundler + paymaster URLs (same URL):
#        https://api.pimlico.io/v2/1315/rpc?apikey=<PIMLICO_KEY>
#   4. Pimlico dashboard → create sponsorship policy on chain 1315.
#      Copy the policy id (sp_xxxxxxxxxxxx) into VITE_PRIVY_SPONSORSHIP_POLICY_ID.
#      NOTE: Privy has no dashboard field for Pimlico's policy id (only
#      Alchemy's). For Pimlico, the policy id is passed in code via
#      <SmartWalletsProvider config={{ paymasterContext: { sponsorshipPolicyId } }}>.
VITE_PRIVY_APP_ID=
VITE_PRIVY_SPONSORSHIP_POLICY_ID=

# Web Push: VAPID public key shipped to the browser for push subscription.
# Matches the backend's VAPID_PUBLIC_KEY exactly (same keypair).
VITE_VAPID_PUBLIC_KEY=

# Public canonical URL of the deployed app (used for OG / canonical tags).
VITE_HATCH_PUBLIC_URL=http://localhost:5173

# Bluesky handle used in the footer + author link (display only).
VITE_BLUESKY_HANDLE=usehatch.bsky.social
