# Backend env — copy to backend/.env and fill in. Real .env is gitignored.

# Postgres connection string (Railway prod: paste the connection URL from the
# Railway Postgres plugin; local dev: docker-compose up postgres or your own).
DATABASE_URL=postgres://postgres:hatch@127.0.0.1:55432/hatch

# Story Aeneid testnet (chain 1315). Override only if you have a custom RPC.
RPC_URL=https://aeneid.storyrpc.io
STORY_API_URL=http://172.192.41.96:1317

API_PORT=4011
INDEXER_START_BLOCK=18800000

# ─────────────────────────── Supabase storage (encrypted ciphertext sink)
# Used by /storage endpoints. Bucket name is case-sensitive.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-from-supabase-dashboard>
SUPABASE_BUCKET=UseHatch

# ─────────────────────────── Cookie config
# Dev defaults work for same-origin reverse-proxy setups; cross-origin dev
# uses the Bearer fallback. For HTTPS cross-origin prod, set:
#   COOKIE_SAMESITE=None  COOKIE_SECURE=1  COOKIE_DOMAIN=.usehatch.xyz
COOKIE_SAMESITE=Lax
COOKIE_SECURE=0
# COOKIE_DOMAIN=

# Whitelisted browser origins for CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─────────────────────────── On-chain operator keys
# Outcome oracle attestation key (EIP-712 signs OutcomeFinalized).
OPERATOR_PRIVATE_KEY=

# SubscriptionPass.minter private key — server-side Pass.mint for Subscribe.
# Without this, /subscribe returns 503 subscribe_not_configured.
PASS_MINTER_PK=

# Treasury PK for the server-side EphemeralPool (anonymous post-reveal reads).
# Optional — leave blank if you don't need server-mediated anonymous reads.
SERVER_TREASURY_PK=

# ─────────────────────────── Web Push (notify worker)
# Must match the keypair the frontend ships VITE_VAPID_PUBLIC_KEY from.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@usehatch.xyz

# ─────────────────────────── Optional integrations
# Bluesky publisher bot (auto-posts reveals). Leave blank to skip.
BSKY_HANDLE=
BSKY_APP_PASSWORD=

# Resend (transactional email for notifications). Leave blank to skip.
RESEND_API_KEY=
